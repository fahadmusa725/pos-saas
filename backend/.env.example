PORT=5000
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
NODE_ENV=development

SUPER_ADMIN_EMAIL=youradmin@dineflow.com
SUPER_ADMIN_PASSWORD=your_super_admin_password

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://app.dineflow.com,https://kitchen.dineflow.com
CLIENT_URL=http://localhost:5173

# Gmail SMTP (free), used to notify the Super Admin of new demo requests.
# EMAIL_PASS is a 16-character Gmail App Password (not your normal Gmail
# password). Generate one at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_gmail_address@gmail.com
EMAIL_PASS=your_16_char_app_password
EMAIL_FROM_NAME=DineFlow
NOTIFY_EMAIL=where_notifications_should_go@example.com

# Ably API key (full key with 'publish' capability) used by the backend to publish
# realtime events. Get it from https://dashboard.ably.com -> Apps -> API Keys
ABLY_API_KEY=your_ably_api_key
